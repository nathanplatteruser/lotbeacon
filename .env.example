# Copy to .env and edit. Everything is optional; defaults run fully air-gapped.

# mock (default, no network) | anthropic
LOTBEACON_AI_PROVIDER=mock
# ANTHROPIC_API_KEY=sk-ant-...
# LOTBEACON_ANTHROPIC_MODEL=claude-sonnet-4-5

# SQLite by default. Postgres later: postgresql+psycopg://user:pass@host/db
# LOTBEACON_DATABASE_URL=sqlite:///./lotbeacon.db

# Inventory older than this (seconds) can't back an availability/price claim
LOTBEACON_INVENTORY_FRESHNESS_SECONDS=900
# Standard Messenger window; anything outside is blocked until a verified basis exists
LOTBEACON_MESSAGING_WINDOW_HOURS=24
PORT=8080
